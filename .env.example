# AnalyFlow Environment Configuration

# API Configuration
VITE_API_URL=https://api.analyflow.com
VITE_WS_URL=wss://api.analyflow.com/ws

# Application Settings
VITE_APP_NAME=AnalyFlow
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Advanced Analytics Dashboard

# Feature Flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_NOTIFICATIONS=true

# Development Settings
VITE_DEBUG_MODE=false
VITE_MOCK_API=false

# Analytics & Monitoring
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Authentication (if implemented)
VITE_AUTH_PROVIDER=
VITE_AUTH_CLIENT_ID=

# Theme Configuration
VITE_DEFAULT_THEME=dark
VITE_ALLOW_THEME_SWITCH=true

# Performance Settings
VITE_CACHE_TIMEOUT=300000
VITE_REQUEST_TIMEOUT=10000
VITE_MAX_RETRIES=3
